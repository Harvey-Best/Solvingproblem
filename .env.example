# Copy to .env.local for local dev. In Vercel, add these under Project → Settings → Environment Variables.

# ── App ────────────────────────────────────────────────────────────────────────
# Public URL of the app, no trailing slash. Used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Any long random string. Salts the IP hash used for anonymous abuse limits.
ANON_ID_SALT=
# Shown on /privacy and /terms as the contact address (privacy requests, billing questions).
CONTACT_EMAIL=
# Optional. The Google OAuth web client id for Google's own sign-in button; read
# from Supabase's Google provider automatically when unset.
GOOGLE_CLIENT_ID=

# ── Supabase (Project Settings → API) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable ("anon") key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret ("service_role") key. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional: low | medium | high | max. Higher = more thinking, slower, pricier. Default low.
ANTHROPIC_EFFORT=low
# Set to 1 to return a canned diagnosis without calling the API (UI work, no token spend).
AI_MOCK=0

# ── Optional ──────────────────────────────────────────────────────────────────
# Amazon Associates tag appended to part search links (e.g. homedoctor-20).
AMAZON_ASSOCIATE_TAG=

# ── Stripe ────────────────────────────────────────────────────────────────────
# The paywall turns on only when the secret key and both price ids are set.
# Secret key: Developers → API keys (sk_test_... in test mode, sk_live_... in live).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint https://<your-domain>/api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Recurring prices: $9.99/month and $69.99/year (price_...). Must match src/lib/plans.ts.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ── Email (Resend) + cron ─────────────────────────────────────────────────────
# Unset: emails are logged instead of sent.
RESEND_API_KEY=
# Must be on a domain verified in Resend.
EMAIL_FROM="Home Doctor <hello@yourdomain.com>"
# Any long random string. Vercel Cron sends it as a Bearer token to /api/cron/*.
CRON_SECRET=

# ── PostHog (product analytics) ───────────────────────────────────────────────
# Project API key (phc_...): PostHog → Project settings → General.
# Unset: nothing is sent, events are only logged.
# Both values are baked in at build time, so redeploy after changing them.
NEXT_PUBLIC_POSTHOG_KEY=
# Your region's ingestion host (https://us.i.posthog.com or https://eu.i.posthog.com).
# Browsers never call it directly: they send to /ingest on this site (next.config.ts).
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
