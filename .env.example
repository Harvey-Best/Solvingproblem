# Copy to .env.local for local dev. In Vercel, add these under Project → Settings → Environment Variables.

# ── App ────────────────────────────────────────────────────────────────────────
# Public URL of the app, no trailing slash. Used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Any long random string. Salts the IP hash used for anonymous abuse limits.
ANON_ID_SALT=

# ── Supabase (Project Settings → API) ─────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable ("anon") key. Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The secret ("service_role") key. Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-4-6.
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional: low | medium | high | max. Higher = more thinking, slower, pricier. Default low.
ANTHROPIC_EFFORT=low
# Set to 1 to return a canned diagnosis without calling the API (UI work, no token spend).
AI_MOCK=0

# ── Optional ──────────────────────────────────────────────────────────────────
# Amazon Associates tag appended to part search links (e.g. homedoctor-20).
AMAZON_ASSOCIATE_TAG=

# ── Phase 3: Stripe ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# ── Phase 3: Email (Resend) + cron ───────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Home Doctor <hello@yourdomain.com>"
CRON_SECRET=

# ── Phase 4: PostHog ──────────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
